# Copy to server/.env. DATABASE_URL must remain server-side and must not use a VITE_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-ENDPOINT/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
# Optional bootstrap admin. Set before running npm run db:seed.
ADMIN_EMAIL=admin@your-campus.example
ADMIN_PASSWORD=replace-with-a-strong-password
PAYMENT_WEBHOOK_SECRET=replace-with-a-separate-long-random-secret
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
