# Keep these server-side. Never expose them with a VITE_ prefix.
RESEND_API_KEY=re_your_server_side_key
EMAIL_FROM=onboarding@resend.dev
# onboarding@resend.dev is for development; use a verified sender domain in production.
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
DPO_COMPANY_TOKEN=your_dpo_company_token
DPO_SERVICE_TYPE=your_dpo_service_type_id
# Optional; defaults to the DPO v6 endpoint.
# DPO_API_URL=https://secure.3gdirectpay.com/API/v6/

# MTN MoMo (server-only). Request both Collections and Disbursements products.
MTN_BASE_URL=https://momoapi.momo.africa
MTN_USER_ID=your_momo_user_id
MTN_CREDENTIAL_TOKEN=your_momo_credential_token
MTN_COLLECTION_SUBSCRIPTION_KEY=your_collections_subscription_key
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=your_disbursements_subscription_key
# Use sandbox for testing and mtnswaziland for the Eswatini production partner account.
MTN_TARGET_ENVIRONMENT=sandbox
# The hostname here must be registered as the provider callback host for the MTN API user.
# MTN_CALLBACK_HOST=studentxchange.vercel.app
# Keep automatic seller payouts off until MTN Disbursements are approved and tested.
MTN_AUTO_PAYOUT=false
# Optional only if your MTN profile requires a transfer type.
# MTN_TRANSFER_TYPE=...

# 10% default; valid range is 0–50%.
PLATFORM_COMMISSION_RATE=0.10
# Required to authorize the scheduled escrow release and MoMo payout polling endpoint.
CRON_SECRET=replace_with_a_long_random_secret
