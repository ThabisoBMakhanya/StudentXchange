# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studentxchange?schema=public"

# Redis (sessions, OTP, queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Admin MFA
ADMIN_MFA_ISSUER=StudentXchange

# Payments
DPO_PAY_API_URL=https://secure.directpay.online/api/v7
DPO_PAY_STORE_TOKEN=your-store-token
DPO_PAY_API_PASSWORD=your-api-password
MTN_MOMO_API_URL=https://momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your-subscription-key
MTN_MOMO_API_USER=your-api-user
MTN_MOMO_API_PASSWORD=your-api-password

# App
PORT=3000
FRONTEND_URL=http://localhost:5173
